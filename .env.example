# Copia este archivo como .env para cambiar los valores.
# Si no existe .env, docker compose usa los valores por defecto.

# Contraseña de root de MySQL dentro del contenedor (por defecto: root)
MYSQL_ROOT_PASSWORD=root
# Puerto de MySQL en tu computador (por defecto: 3307)
MYSQL_PORT=3307
# Puerto del backend en tu computador (por defecto: 8080)
BACKEND_PORT=8080
