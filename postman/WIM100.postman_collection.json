{
  "info": {
    "name": "WIM 100 - wim100-backend",
    "description": "Pruebas del microservicio WIM 100 (DSY1105, EP4). Ejecutar en orden con Run collection: el paso 4 guarda el id que usan los pasos 7 a 11. Datos ficticios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "idNueva",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Listar postulantes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/postulantes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "postulantes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Trae una lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login correcto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"evaluadora1\",\n  \"password\": \"wim2026\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Trae el rol y no la contraseña\", () => { const j = pm.response.json(); pm.expect(j.rol).to.eql(\"EVALUADORA\"); pm.expect(j).to.not.have.property(\"password\"); });"
            ]
          }
        }
      ]
    },
